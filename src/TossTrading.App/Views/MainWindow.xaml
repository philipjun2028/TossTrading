<dx:ThemedWindow x:Class="TossTrading.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 xmlns:v="clr-namespace:TossTrading.App.Views"
                 Title="TossTrading — Stocks in Play 모멘텀 트레이더"
                 Width="1600" Height="960" MinWidth="1200" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 FontFamily="Malgun Gothic">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="320" />
        </Grid.RowDefinitions>

        <!-- ============ 툴바 ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Up}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ModeBadge}" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="데이터" Style="{StaticResource Caption}" Margin="4,0" />
                    <dxe:ComboBoxEdit Width="200" Margin="3" IsTextEditable="False"
                                      ItemsSource="{Binding DataSourceOptions}" DisplayMember="Label" ValueMember="Value"
                                      EditValue="{Binding DataSource}" IsEnabled="{Binding CanEditMode}" />
                    <TextBlock Text="주문" Style="{StaticResource Caption}" Margin="8,0,4,0" />
                    <dxe:ComboBoxEdit Width="160" Margin="3" IsTextEditable="False"
                                      ItemsSource="{Binding ExecutionOptions}" DisplayMember="Label" ValueMember="Value"
                                      EditValue="{Binding Execution}" IsEnabled="{Binding CanEditMode}" />
                    <Button Content="▶ 시작" Command="{Binding StartCommand}" Margin="10,3,3,3" Padding="12,4" FontWeight="SemiBold" />
                    <Button Content="■ 중지" Command="{Binding StopCommand}" Margin="3" Padding="12,4" />
                    <dxe:CheckEdit Content="🤖 자동 운용" IsChecked="{Binding AutoPilotEnabled}" Margin="14,3,3,3" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="켜면 장중에는 단타 후보를 자동으로 골라 단타 봇을 돌리고, 14:50 단타 정리 후 종가매매 후보를 골라 종가베팅(익일 매도)을 자동 진행합니다. 시간·봇 수·프리셋은 [설정 → 자동 운용]" />
                    <TextBlock Text="{Binding AutoPilotStatus}" Margin="6,0" VerticalAlignment="Center" Foreground="#FF22C55E" />
                    <TextBlock Text="{Binding Status}" Margin="12,0" Foreground="{StaticResource SubText}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Clock}" FontSize="15" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                    <Button Content="📈 백테스트" Command="{Binding OpenBacktestCommand}" Margin="3" Padding="12,4"
                            ToolTip="기간을 정해 과거 데이터로 자동 운용(단타→종가매매)을 돌려보고 거래 내역·수익률·수익금을 봅니다" />
                    <Button Content="📊 성과 분석" Command="{Binding OpenAnalysisCommand}" Margin="3" Padding="12,4"
                            ToolTip="거래 기록으로 전략·진입조건·청산별 성과와 개선 제안을 봅니다" />
                    <Button Content="⚙ 설정" Command="{Binding OpenSettingsCommand}" Margin="3" Padding="12,4" />
                    <Button Content="킬스위치 해제" Command="{Binding ResetKillSwitchCommand}" Margin="3" Padding="12,4"
                            Visibility="{Binding KillSwitchActive, Converter={StaticResource BoolToVis}}" />
                    <Button Content="⛔ 킬스위치" Command="{Binding KillSwitchCommand}" Margin="3" Padding="12,4"
                            Background="#FFB91C2C" Foreground="White" FontWeight="Bold"
                            ToolTip="전 봇 정지 + 미체결 취소 + 보유분 시장가 청산" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 계좌 요약 ============ -->
        <UniformGrid Grid.Row="1" Rows="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="운용 기준 금액" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding StartEquity, StringFormat={}{0:N0}원}" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="평가금액 / 예수금" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Value}">
                        <Run Text="{Binding Equity, StringFormat={}{0:N0}, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{StaticResource SubText}" />
                        <Run Text="{Binding Cash, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SubText}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="당일 실현 손익 (수수료·세금 차감)" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding RealizedNet, StringFormat={}{0:+#,0;-#,0;0}원}" Style="{StaticResource Value}"
                               Foreground="{Binding RealizedNet, Converter={StaticResource SignBrush}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="미실현 손익 (예상 비용 차감)" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UnrealizedNet, StringFormat={}{0:+#,0;-#,0;0}원}" Style="{StaticResource Value}"
                               Foreground="{Binding UnrealizedNet, Converter={StaticResource SignBrush}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="일 손실 한도 사용률" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding LossGaugeText}" FontWeight="SemiBold" Margin="0,2"
                               Foreground="{Binding DailyPnlPct, Converter={StaticResource SignBrush}}" />
                    <ProgressBar Value="{Binding LossGauge, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource Warn}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="보유 종목 / 한도" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding PositionsText}" Style="{StaticResource Value}" />
                    <TextBlock Text="{Binding BlockReason, StringFormat=⛔ {0}}" Foreground="{StaticResource Warn}" FontSize="11"
                               Visibility="{Binding BlockReason, Converter={StaticResource NullToVis}}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 스캐너 + 봇 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding ScannerHeader}" Margin="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="모드" Style="{StaticResource Caption}" Margin="4,0" />
                        <dxe:ComboBoxEdit Width="180" Margin="3" IsTextEditable="False"
                                          ItemsSource="{Binding ScanModeOptions}" DisplayMember="Label" ValueMember="Value"
                                          EditValue="{Binding ScannerMode}" IsEnabled="{Binding CanChangeScanMode}"
                                          ToolTip="자동 운용 중에는 시간대에 따라 자동으로 바뀝니다" />
                        <TextBlock Margin="8,0" Foreground="{StaticResource SubText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Visibility="{Binding IsClosingMode, Converter={StaticResource BoolToVis}}"
                                   Text="14:30 이후 사용 권장. ✔ 통과 ✖ 실패 ? 데이터 없음 · 상위 종목에 '종가베팅' 프리셋으로 봇 추가 → 15:00~15:19 에 봇이 조건 재확인 후 매수" />
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <TextBlock Text="프리셋" Style="{StaticResource Caption}" Margin="4,0" />
                        <dxe:ComboBoxEdit Width="180" Margin="3" IsTextEditable="False" ItemsSource="{Binding PresetNames}" EditValue="{Binding SelectedPreset}" />
                        <Button Content="＋ 선택 종목 봇 추가" Command="{Binding AddSelectedCandidateCommand}" Margin="3" Padding="10,4" FontWeight="SemiBold" />
                        <dxe:TextEdit Width="90" Margin="3" EditValue="{Binding ManualSymbol, UpdateSourceTrigger=PropertyChanged}" NullText="종목코드" />
                        <Button Content="코드로 추가" Command="{Binding AddManualSymbolCommand}" Margin="3" Padding="10,4" />
                    </WrapPanel>
                    <dxg:GridControl ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" AutoGenerateColumns="None">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name" Header="종목" Width="120" />
                            <dxg:GridColumn FieldName="Price" Header="현재가" Width="70">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ChangePct" Header="등락%" Width="60">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.00;-0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TradingAmountEok" Header="거래대금(억)" Width="75">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Rvol" Header="RVOL" Width="50" Visible="{Binding IsDayMode}">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="F1" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Strength" Header="체결강도" Width="60">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="F0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="VwapDist" Header="VWAP±%" Width="60">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.0;-0.0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TickCostPct" Header="틱비용%" Width="60">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="F3" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Score" Header="점수" Width="45">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="F0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Tags" Header="태그" Width="90" />
                            <dxg:GridColumn FieldName="RangePosPct" Header="고가권%" Width="55" Visible="{Binding IsClosingMode}"
                                            ToolTip="당일 저가~고가 중 현재가 위치 (100 = 고가)">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="F0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Trend30m" Header="30분%" Width="55" Visible="{Binding IsClosingMode}">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.0;-0.0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PassText" Header="통과" Width="40" Visible="{Binding IsClosingMode}" />
                            <dxg:GridColumn FieldName="Checks" Header="종가 조건" Width="210" Visible="{Binding IsClosingMode}" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"
                                           ShowIndicator="False" AllowColumnFiltering="False">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="ChangePct" Expression="[ChangePct] &gt; 0">
                                        <dx:Format Foreground="#FFF04452" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="ChangePct" Expression="[ChangePct] &lt; 0">
                                        <dx:Format Foreground="#FF3B82F6" />
                                    </dxg:FormatCondition>
                                    <dxg:DataBarFormatCondition FieldName="Score" PredefinedFormatName="BlueGradientDataBar" />
                                    <dxg:FormatCondition FieldName="Name" Expression="Contains([Tags], '종가후보')" ApplyToRow="True">
                                        <dx:Format FontWeight="Bold" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="Trend30m" Expression="[Trend30m] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="Trend30m" Expression="[Trend30m] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <GroupBox Grid.Column="2" Header="봇 — 종목별 독립 운용 (각각 설정)" Margin="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,4" Padding="8,4" BorderBrush="{StaticResource Warn}"
                            Visibility="{Binding SelectedBot.HasPendingSignal, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="거절" Command="{Binding RejectCommand}" Margin="3" Padding="10,4" />
                            <Button DockPanel.Dock="Right" Content="✔ 승인(매수)" Command="{Binding ApproveCommand}" Margin="3" Padding="10,4" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedBot.PendingSignal, StringFormat=진입 신호: {0}}" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" IsEnabled="{Binding HasSelectedBot}">
                        <Button Content="▶ 시작" Command="{Binding StartBotCommand}" Margin="3" Padding="10,4" />
                        <Button Content="수동 매수" Command="{Binding ManualBuyCommand}" Margin="3" Padding="10,4" FontWeight="SemiBold" />
                        <Button Content="청산" Command="{Binding FlattenCommand}" Margin="3" Padding="10,4" />
                        <Button Content="정지(청산)" Command="{Binding StopBotCommand}" Margin="3" Padding="10,4" />
                        <Button Content="설정 변경" Command="{Binding EditBotCommand}" Margin="3" Padding="10,4" />
                        <Button Content="프리셋으로 저장" Command="{Binding SaveAsPresetCommand}" Margin="3" Padding="10,4" />
                        <Button Content="삭제" Command="{Binding RemoveBotCommand}" Margin="3" Padding="10,4" />
                    </WrapPanel>
                    <dxg:GridControl ItemsSource="{Binding Bots}" SelectedItem="{Binding SelectedBot}" AutoGenerateColumns="None">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name" Header="종목" Width="100" />
                            <dxg:GridColumn FieldName="Origin" Header="구분" Width="60" />
                            <dxg:GridColumn FieldName="Strategy" Header="전략" Width="60" />
                            <dxg:GridColumn FieldName="Mode" Header="모드" Width="60" />
                            <dxg:GridColumn FieldName="StateText" Header="상태" Width="160" />
                            <dxg:GridColumn FieldName="Quantity" Header="수량" Width="55">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="AveragePrice" Header="평균가" Width="70">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="LastPrice" Header="현재가" Width="70">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="StopPrice" Header="손절가" Width="70">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="UnrealizedNet" Header="미실현(Net)" Width="80">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+#,0;-#,0;0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="UnrealizedPct" Header="%" Width="55">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.00;-0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="RealizedNet" Header="실현(Net)" Width="80">
                                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+#,0;-#,0;0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TargetProgress" Header="봇 목표" Width="100">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" ToolTip="{Binding RowData.Row.TargetText}">
                                            <ProgressBar Height="6" Maximum="100" Foreground="{StaticResource Up}"
                                                         Value="{Binding RowData.Row.TargetProgress, Converter={StaticResource Progress}, Mode=OneWay}" />
                                            <TextBlock Text="{Binding RowData.Row.TargetText}" FontSize="10" Foreground="{StaticResource SubText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entries" Header="진입" Width="100" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True" NavigationStyle="Row"
                                           ShowIndicator="False" AllowColumnFiltering="False">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="UnrealizedNet" Expression="[UnrealizedNet] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="UnrealizedNet" Expression="[UnrealizedNet] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="UnrealizedPct" Expression="[UnrealizedPct] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="UnrealizedPct" Expression="[UnrealizedPct] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="RealizedNet" Expression="[RealizedNet] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="RealizedNet" Expression="[RealizedNet] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="StateText" Expression="[HasPendingSignal] = True"><dx:Format Foreground="#FFF5A524" FontWeight="Bold" /></dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </DockPanel>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============ 차트 / 거래 / 로그 ============ -->
        <dx:DXTabControl Grid.Row="4" Margin="4,0,4,4">
            <dx:DXTabItem Header="차트">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" Margin="6,4" Foreground="{StaticResource SubText}" />
                    <v:PriceChart Chart="{Binding Chart}" />
                </DockPanel>
            </dx:DXTabItem>
            <dx:DXTabItem Header="거래 내역">
                <dxg:GridControl ItemsSource="{Binding Trades}" AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Time" Header="시간" Width="90" />
                        <dxg:GridColumn FieldName="Name" Header="종목" Width="110" />
                        <dxg:GridColumn FieldName="Strategy" Header="전략" Width="70" />
                        <dxg:GridColumn FieldName="Quantity" Header="수량" Width="60">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entry" Header="평균 매수" Width="80">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Exit" Header="평균 매도" Width="80">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="NetPnl" Header="순손익(수수료·세금 차감)" Width="130">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+#,0;-#,0;0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="NetPct" Header="순수익률%" Width="75">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.00;-0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="R" Header="R" Width="55">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.00;-0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ExitReason" Header="청산 사유" Width="200" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="NetPnl" SummaryType="Sum" DisplayFormat="합계 {0:+#,0;-#,0;0}" />
                        <dxg:GridSummaryItem FieldName="Name" SummaryType="Count" DisplayFormat="{}{0}건" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True" ShowTotalSummary="True" ShowIndicator="False">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition FieldName="NetPnl" Expression="[NetPnl] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="NetPnl" Expression="[NetPnl] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="NetPct" Expression="[NetPct] &gt; 0"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="NetPct" Expression="[NetPct] &lt; 0"><dx:Format Foreground="#FF3B82F6" /></dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="로그">
                <dxg:GridControl ItemsSource="{Binding Logs}" AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Time" Header="시각" Width="70" />
                        <dxg:GridColumn FieldName="Level" Header="구분" Width="50" />
                        <dxg:GridColumn FieldName="Source" Header="출처" Width="100" />
                        <dxg:GridColumn FieldName="Message" Header="내용" Width="700" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True" ShowIndicator="False">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition FieldName="Message" Expression="[Level] = '오류'" ApplyToRow="True"><dx:Format Foreground="#FFF04452" /></dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Message" Expression="[Level] = '주의'" ApplyToRow="True"><dx:Format Foreground="#FFF5A524" /></dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Message" Expression="[Level] = '체결'" ApplyToRow="True"><dx:Format Foreground="#FF22C55E" /></dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</dx:ThemedWindow>
