<Window x:Class="TossTrading.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TossTrading.App.Controls"
        Title="TossTrading — Stocks in Play 모멘텀 트레이더"
        Width="1600" Height="960" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <!-- ============ 툴바 ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Up}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ModeBadge}" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="데이터" Style="{StaticResource Caption}" Margin="4,0" />
                    <ComboBox Width="190" ItemsSource="{Binding DataSourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding DataSource}" IsEnabled="{Binding CanEditMode}" />
                    <TextBlock Text="주문" Style="{StaticResource Caption}" Margin="8,0,4,0" />
                    <ComboBox Width="150" ItemsSource="{Binding ExecutionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Execution}" IsEnabled="{Binding CanEditMode}" />
                    <Button Content="▶ 시작" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="10,3,3,3" />
                    <Button Content="■ 중지" Command="{Binding StopCommand}" />
                    <TextBlock Text="{Binding Status}" Margin="12,0" Foreground="{StaticResource SubText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Clock}" FontSize="15" FontWeight="SemiBold" Margin="10,0" />
                    <Button Content="⚙ 설정" Command="{Binding OpenSettingsCommand}" />
                    <Button Content="킬스위치 해제" Command="{Binding ResetKillSwitchCommand}"
                            Visibility="{Binding KillSwitchActive, Converter={StaticResource BoolToVis}}" />
                    <Button Content="⛔ 킬스위치" Style="{StaticResource DangerButton}" Command="{Binding KillSwitchCommand}"
                            ToolTip="전 봇 정지 + 미체결 취소 + 보유분 시장가 청산" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 계좌 요약 ============ -->
        <UniformGrid Grid.Row="1" Rows="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="운용 기준 금액" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding StartEquity, StringFormat={}{0:N0}원}" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="평가금액 / 예수금" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Value}">
                        <Run Text="{Binding Equity, StringFormat={}{0:N0}, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{StaticResource SubText}" />
                        <Run Text="{Binding Cash, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SubText}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="당일 실현 손익 (비용 차감)" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding RealizedNet, StringFormat={}{0:+#,0;-#,0;0}원}" Style="{StaticResource Value}"
                               Foreground="{Binding RealizedNet, Converter={StaticResource SignBrush}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="미실현 손익" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UnrealizedNet, StringFormat={}{0:+#,0;-#,0;0}원}" Style="{StaticResource Value}"
                               Foreground="{Binding UnrealizedNet, Converter={StaticResource SignBrush}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="일 손실 한도 사용률" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding LossGaugeText}" FontWeight="SemiBold" Margin="0,2"
                               Foreground="{Binding DailyPnlPct, Converter={StaticResource SignBrush}}" />
                    <ProgressBar Value="{Binding LossGauge, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Warn}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="보유 종목 / 한도" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding PositionsText}" Style="{StaticResource Value}" />
                    <TextBlock Text="{Binding BlockReason, StringFormat=⛔ {0}}" Foreground="{StaticResource Warn}" FontSize="11"
                               Visibility="{Binding BlockReason, Converter={StaticResource NullToVis}}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 스캐너 + 봇 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="스캐너 — Stocks in Play (거래대금·RVOL·등락률·틱비용·경고 필터)">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <TextBlock Text="프리셋" Style="{StaticResource Caption}" Margin="4,0" />
                        <ComboBox Width="170" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" />
                        <Button Content="＋ 선택 종목 봇 추가" Style="{StaticResource PrimaryButton}" Command="{Binding AddSelectedCandidateCommand}" />
                        <TextBox Width="90" Text="{Binding ManualSymbol, UpdateSourceTrigger=PropertyChanged}" ToolTip="종목코드 직접 입력 (예: 005930)" />
                        <Button Content="코드로 추가" Command="{Binding AddManualSymbolCommand}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="종목" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="현재가" Binding="{Binding Price, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTemplateColumn Header="등락%" SortMemberPath="ChangePct">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}}" HorizontalAlignment="Right"
                                                   Foreground="{Binding ChangePct, Converter={StaticResource SignBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="거래대금(억)" Binding="{Binding TradingAmountEok, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="RVOL" Binding="{Binding Rvol}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="체결강도" Binding="{Binding Strength}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="VWAP±" Binding="{Binding VwapDist}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="틱비용%" Binding="{Binding TickCostPct}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="점수" Binding="{Binding Score, StringFormat={}{0:F0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="태그" Binding="{Binding Tags}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <GroupBox Grid.Column="2" Header="봇 — 종목별 독립 운용 (각각 설정)">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,4" Padding="8,4"
                            Visibility="{Binding SelectedBot.HasPendingSignal, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                            BorderBrush="{StaticResource Warn}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="거절" Command="{Binding RejectCommand}" />
                            <Button DockPanel.Dock="Right" Content="✔ 승인(매수)" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" />
                            <TextBlock Text="{Binding SelectedBot.PendingSignal, StringFormat=진입 신호: {0}}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" IsEnabled="{Binding HasSelectedBot}">
                        <Button Content="▶ 시작" Command="{Binding StartBotCommand}" />
                        <Button Content="수동 매수" Style="{StaticResource PrimaryButton}" Command="{Binding ManualBuyCommand}" />
                        <Button Content="청산" Command="{Binding FlattenCommand}" />
                        <Button Content="정지(청산)" Command="{Binding StopBotCommand}" />
                        <Button Content="설정 변경" Command="{Binding EditBotCommand}" />
                        <Button Content="프리셋으로 저장" Command="{Binding SaveAsPresetCommand}" />
                        <Button Content="삭제" Command="{Binding RemoveBotCommand}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Bots}" SelectedItem="{Binding SelectedBot}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="종목" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="전략" Binding="{Binding Strategy}" />
                            <DataGridTextColumn Header="모드" Binding="{Binding Mode}" />
                            <DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="170" />
                            <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="평균가" Binding="{Binding AveragePrice, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="현재가" Binding="{Binding LastPrice, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                            <DataGridTextColumn Header="손절가" Binding="{Binding StopPrice}" ElementStyle="{StaticResource Num}" />
                            <DataGridTemplateColumn Header="미실현(Net)">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Foreground="{Binding UnrealizedNet, Converter={StaticResource SignBrush}}">
                                            <Run Text="{Binding UnrealizedNet, StringFormat={}{0:+#,0;-#,0;0}, Mode=OneWay}" />
                                            <Run Text="{Binding UnrealizedPct, StringFormat=({0:+0.00;-0.00}%), Mode=OneWay}" FontSize="11" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="실현(Net)">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RealizedNet, StringFormat={}{0:+#,0;-#,0;0}}" HorizontalAlignment="Right"
                                                   Foreground="{Binding RealizedNet, Converter={StaticResource SignBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="봇 목표" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding TargetText}">
                                            <ProgressBar Value="{Binding TargetProgress, Converter={StaticResource Progress}, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Up}" />
                                            <TextBlock Text="{Binding TargetText}" FontSize="10" Foreground="{StaticResource SubText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="진입" Binding="{Binding Entries}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============ 차트 / 거래 / 로그 ============ -->
        <TabControl Grid.Row="4" Margin="4,0,4,4">
            <TabItem Header="차트">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" Margin="6,4" Foreground="{StaticResource SubText}" />
                    <ctl:CandleChart Chart="{Binding Chart}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="거래 내역">
                <DataGrid ItemsSource="{Binding Trades}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시간" Binding="{Binding Time}" />
                        <DataGridTextColumn Header="종목" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="전략" Binding="{Binding Strategy}" />
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                        <DataGridTextColumn Header="평균 매수" Binding="{Binding Entry, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                        <DataGridTextColumn Header="평균 매도" Binding="{Binding Exit, StringFormat={}{0:N0}}" ElementStyle="{StaticResource Num}" />
                        <DataGridTemplateColumn Header="순손익">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NetPnl, StringFormat={}{0:+#,0;-#,0;0}}" HorizontalAlignment="Right"
                                               Foreground="{Binding NetPnl, Converter={StaticResource SignBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="%" Binding="{Binding NetPct, StringFormat={}{0:+0.00;-0.00}}" ElementStyle="{StaticResource Num}" />
                        <DataGridTextColumn Header="R" Binding="{Binding R}" ElementStyle="{StaticResource Num}" />
                        <DataGridTextColumn Header="청산 사유" Binding="{Binding ExitReason}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="로그">
                <DataGrid ItemsSource="{Binding Logs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시각" Binding="{Binding Time}" />
                        <DataGridTextColumn Header="구분" Binding="{Binding Level}" />
                        <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="110" />
                        <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
