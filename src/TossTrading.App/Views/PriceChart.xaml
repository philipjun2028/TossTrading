<UserControl x:Class="TossTrading.App.Views.PriceChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts">
    <!-- 1분봉 캔들 + VWAP + 평균단가/손절/시가범위 상수선. 국내 관례: 양봉 빨강, 음봉 파랑 -->
    <dxc:ChartControl x:Name="ChartCtl" AnimationMode="Disabled" CrosshairEnabled="True" BorderThickness="0">
        <dxc:ChartControl.Legend>
            <dxc:Legend HorizontalPosition="Left" VerticalPosition="Top" Orientation="Horizontal" />
        </dxc:ChartControl.Legend>
        <dxc:XYDiagram2D>
            <dxc:XYDiagram2D.AxisX>
                <dxc:AxisX2D>
                    <dxc:AxisX2D.Label>
                        <dxc:AxisLabel Staggered="False" />
                    </dxc:AxisX2D.Label>
                </dxc:AxisX2D>
            </dxc:XYDiagram2D.AxisX>
            <dxc:XYDiagram2D.AxisY>
                <dxc:AxisY2D x:Name="AxisY" Alignment="Far" GridLinesVisible="True">
                    <dxc:AxisY2D.WholeRange>
                        <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" />
                    </dxc:AxisY2D.WholeRange>
                    <dxc:AxisY2D.Label>
                        <dxc:AxisLabel TextPattern="{}{V:N0}" />
                    </dxc:AxisY2D.Label>
                </dxc:AxisY2D>
            </dxc:XYDiagram2D.AxisY>

            <dxc:CandleStickSeries2D x:Name="CandleSeries" DisplayName="1분봉"
                                     ArgumentScaleType="Qualitative" ArgumentDataMember="Time"
                                     OpenValueDataMember="Open" HighValueDataMember="High"
                                     LowValueDataMember="Low" CloseValueDataMember="Close"
                                     Brush="#FFF04452" CandleWidth="0.7">
                <dxc:CandleStickSeries2D.ReductionOptions>
                    <dxc:ReductionStockOptions Brush="#FF3B82F6" ColorMode="OpenToCloseValue" Level="Close" />
                </dxc:CandleStickSeries2D.ReductionOptions>
            </dxc:CandleStickSeries2D>

            <dxc:LineSeries2D x:Name="VwapSeries" DisplayName="VWAP"
                              ArgumentScaleType="Qualitative" ArgumentDataMember="Time" ValueDataMember="Value"
                              Brush="#FFF5A524" MarkerVisible="False">
                <dxc:LineSeries2D.LineStyle>
                    <dxc:LineStyle Thickness="2" />
                </dxc:LineSeries2D.LineStyle>
            </dxc:LineSeries2D>
        </dxc:XYDiagram2D>
    </dxc:ChartControl>
</UserControl>
