<dx:ThemedWindow x:Class="TossTrading.App.Views.AnalysisWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 Title="성과 분석 · 개선 제안" Width="1200" Height="820" WindowStartupLocation="CenterOwner"
                 FontFamily="Malgun Gothic">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:ComboBoxEdit Width="120" Margin="3" IsTextEditable="False" ItemsSource="{Binding DayOptions}"
                              DisplayMember="Label" ValueMember="Value" EditValue="{Binding Days}" />
            <TextBlock Text="데이터" VerticalAlignment="Center" Margin="10,0,4,0" />
            <dxe:ComboBoxEdit Width="140" Margin="3" IsTextEditable="False" ItemsSource="{Binding SourceOptions}"
                              DisplayMember="Label" ValueMember="Value" EditValue="{Binding Source}" />
            <Button Content="🔍 분석" Command="{Binding AnalyzeCommand}" Margin="10,3,3,3" Padding="14,4" FontWeight="SemiBold" />
            <Button Content="리포트·CSV 저장" Command="{Binding ExportCommand}" Margin="3" Padding="10,4"
                    ToolTip="report.md / trades.csv / signals.csv 를 reports 폴더에 저장 (엑셀에서 열 수 있음)" />
            <Button Content="📂 폴더 열기" Command="{Binding OpenFolderCommand}" Margin="3" Padding="10,4" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0" Opacity="0.75" />
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="개선 제안 (표본 5건 이상 구간 기준)" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding Suggestions}" MaxHeight="150">
                <ItemsControl.Template>
                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="2" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <dx:DXTabControl>
            <dx:DXTabItem Header="리포트">
                <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="D2Coding, Consolas, Malgun Gothic" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </dx:DXTabItem>
            <dx:DXTabItem Header="거래 상세">
                <dxg:GridControl ItemsSource="{Binding Trades}" AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="ExitTime" Header="청산시각" Width="120">
                            <dxg:GridColumn.EditSettings><dxe:DateEditSettings DisplayFormat="MM-dd HH:mm:ss" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Name" Header="종목" Width="130" />
                        <dxg:GridColumn FieldName="Strategy" Header="전략" Width="70" />
                        <dxg:GridColumn FieldName="Source" Header="구분" Width="60" />
                        <dxg:GridColumn FieldName="NetPct" Header="순수익%" Width="65">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+0.00;-0.00;0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="NetPnl" Header="순손익" Width="75">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="+#,0;-#,0;0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="R" Header="R" Width="45">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="MfePct" Header="MFE%" Width="55" ToolTip="보유 중 최고 수익">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="MaePct" Header="MAE%" Width="55" ToolTip="보유 중 최대 손실">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="RiskPct" Header="손절거리%" Width="65">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ExitKind" Header="청산" Width="75" />
                        <dxg:GridColumn FieldName="HoldMinutes" Header="보유(분)" Width="60">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ChangePct" Header="진입등락%" Width="65">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.0" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="VwapDistPct" Header="VWAP이격%" Width="70">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="RangePosPct" Header="범위위치%" Width="65" />
                        <dxg:GridColumn FieldName="Strength" Header="체결강도" Width="60" />
                        <dxg:GridColumn FieldName="VolumeRatio" Header="거래량배수" Width="65" />
                        <dxg:GridColumn FieldName="EntrySlippagePct" Header="진입슬립%" Width="65">
                            <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="0.00" HorizontalContentAlignment="Right" /></dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="EntryReason" Header="진입근거" Width="220" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="NetPnl" SummaryType="Sum" DisplayFormat="합계 {0:+#,0;-#,0;0}" />
                        <dxg:GridSummaryItem FieldName="NetPct" SummaryType="Average" DisplayFormat="평균 {0:+0.00;-0.00}" />
                        <dxg:GridSummaryItem FieldName="Name" SummaryType="Count" DisplayFormat="{}{0}건" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" ShowGroupPanel="True" ShowTotalSummary="True" NavigationStyle="Row">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition FieldName="NetPct" Expression="[NetPct] &gt; 0">
                                    <dx:Format Foreground="#FFF04452" />
                                </dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="NetPct" Expression="[NetPct] &lt; 0">
                                    <dx:Format Foreground="#FF3B82F6" />
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </DockPanel>
</dx:ThemedWindow>
