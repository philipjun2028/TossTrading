<dx:ThemedWindow x:Class="TossTrading.App.Views.BotSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 Title="{Binding Title}" Width="860" Height="760" WindowStartupLocation="CenterOwner"
                 FontFamily="Malgun Gothic">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding CostHint}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="4" />
            <DockPanel>
                <dxe:CheckEdit DockPanel.Dock="Left" Content="추가 후 바로 시작" IsChecked="{Binding StartImmediately}"
                               Visibility="{Binding ShowStartOption, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="비용 점검" Command="{Binding UpdateCostHintCommand}" Margin="3" Padding="12,4" />
                    <Button Content="취소" Command="{Binding CancelCommand}" IsCancel="True" Margin="3" Padding="12,4" />
                    <Button Content="확인" Command="{Binding OkCommand}" IsDefault="True" Margin="3" Padding="16,4" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="① 진입" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="운용 모드" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="1" Margin="3"><dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{Binding ModeOptions}" DisplayMember="Label" ValueMember="Value" EditValue="{Binding S.Mode}" /></ContentControl>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="진입 전략" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="3" Margin="3"><dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{Binding StrategyOptions}" DisplayMember="Label" ValueMember="Value" EditValue="{Binding S.Strategy}" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="진입 허용 시작 (HH:mm)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Margin="3"><dxe:TextEdit EditValue="{Binding S.EntryStartTime, Converter={StaticResource TimeOnlyConv}}" MaskType="RegEx" Mask="([01][0-9]|2[0-3]):[0-5][0-9]" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="진입 허용 종료 (HH:mm)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="3" Margin="3"><dxe:TextEdit EditValue="{Binding S.EntryEndTime, Converter={StaticResource TimeOnlyConv}}" MaskType="RegEx" Mask="([01][0-9]|2[0-3]):[0-5][0-9]" /></ContentControl>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="매수가 = 매도1호가 + N틱" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="2" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.EntrySlippageTicks}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="매수 미체결 취소 (초)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="2" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.EntryTimeoutSeconds}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ORB 시가범위 (분)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="3" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.OrbMinutes}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                </Grid>
                <TextBlock Text="② 자금 (포지션 사이징)" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="사이징 방식" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="1" Margin="3"><dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{Binding SizingOptions}" DisplayMember="Label" ValueMember="Value" EditValue="{Binding S.Sizing}" /></ContentControl>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="거래당 리스크 (계좌 %)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.RiskPerTradePct}" EditValueType="{x:Type sys:Decimal}" Increment="0.05" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="고정 투입금 (원)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.FixedAmount}" EditValueType="{x:Type sys:Decimal}" Increment="100000" MinValue="0" DisplayFormatString="N0" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="봇 최대 투입금 (원)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.MaxPositionAmount}" EditValueType="{x:Type sys:Decimal}" Increment="100000" MinValue="0" DisplayFormatString="N0" /></ContentControl>
                </Grid>
                <TextBlock Text="③ 청산 규칙 (가격 기준 %, 순수익은 약 0.23%p 낮음)" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="손절 %" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.StopLossPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <ContentControl Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="3"><dxe:CheckEdit Content="전략의 구조적 손절 우선 (ORB 저가, 박스 하단 등)" IsChecked="{Binding S.UseStructuralStop}" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="1차 분할 익절 % (0=끔)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.PartialTakeProfitPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="1차 매도 비율 %" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.PartialTakeProfitRatioPct}" EditValueType="{x:Type sys:Decimal}" Increment="10" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="최종 목표 익절 % (0=끔)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="2" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.TakeProfitPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <ContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="3"><dxe:CheckEdit Content="+1R 도달 시 손절을 본절(비용 포함)로 이동" IsChecked="{Binding S.MoveStopToBreakEven}" /></ContentControl>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="트레일링 활성화 % (0=끔)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="3" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.TrailingActivationPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="트레일링 폭 (고점 대비 %)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="3" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.TrailingDistancePct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="타임스탑 (분, 0=끔)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="4" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.TimeStopMinutes}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="타임스탑 최소 진척 (R)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="4" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.TimeStopMinProgressR}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="강제 청산 시각 (HH:mm)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="5" Grid.Column="1" Margin="3"><dxe:TextEdit EditValue="{Binding S.ForceExitTime, Converter={StaticResource TimeOnlyConv}}" MaskType="RegEx" Mask="([01][0-9]|2[0-3]):[0-5][0-9]" /></ContentControl>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="매도 미체결→시장가 (초)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="5" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.ExitTimeoutSeconds}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                </Grid>
                <TextBlock Text="④ 봇 목표 · 정지 조건 (수수료·세금 차감 순손익 기준)" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="봇 목표 수익 % (도달 시 종료)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.BotTargetProfitPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="봇 손실 한도 % (도달 시 정지)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.BotMaxLossPct}" EditValueType="{x:Type sys:Decimal}" Increment="0.1" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="최대 진입 횟수" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.MaxEntries}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="재진입 쿨다운 (초)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.CooldownSeconds}" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" IsFloatValue="False" /></ContentControl>
                </Grid>
                <TextBlock Text="⑤ 종가매매 · 익일 보유" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="3"><dxe:CheckEdit Content="장 마감 후에도 보유 (익일 매도)" IsChecked="{Binding S.HoldOvernight}" /></ContentControl>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="익일 청산 방식" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="0" Grid.Column="3" Margin="3"><dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{Binding NextDayExitOptions}" DisplayMember="Label" ValueMember="Value" EditValue="{Binding S.NextDayExitMode}" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="익일 청산 시각 (HH:mm)" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Margin="3"><dxe:TextEdit EditValue="{Binding S.NextDayExitTime, Converter={StaticResource TimeOnlyConv}}" MaskType="RegEx" Mask="([01][0-9]|2[0-3]):[0-5][0-9]" /></ContentControl>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="종가 후보: 고저범위 위치 하한" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="1" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.ClosingMinRangePosition}" EditValueType="{x:Type sys:Decimal}" Increment="0.05" MinValue="0" MaxValue="1" DisplayFormatString="0.00" /></ContentControl>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="종가 후보: 등락률 하한 %" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="2" Grid.Column="1" Margin="3"><dxe:SpinEdit EditValue="{Binding S.ClosingMinChangePct}" EditValueType="{x:Type sys:Decimal}" Increment="0.5" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="종가 후보: 등락률 상한 %" Style="{StaticResource Label}" />
                    <ContentControl Grid.Row="2" Grid.Column="3" Margin="3"><dxe:SpinEdit EditValue="{Binding S.ClosingMaxChangePct}" EditValueType="{x:Type sys:Decimal}" Increment="0.5" MinValue="0" DisplayFormatString="0.##" /></ContentControl>
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="4,6" TextWrapping="Wrap" Foreground="{StaticResource SubText}" FontSize="11"
                               Text="익일 보유 봇은 당일 강제청산·타임스탑을 쓰지 않고, 정규장(09:00~15:20)에서만 손절/익절을 적용합니다 (동시호가·NXT 시간외 체결로 손절되지 않도록). 진입 종료 시각은 15:20 이전이어야 합니다. 밤사이 갭 하락은 손절가보다 더 낮게 체결될 수 있으니 손절 %와 투입금을 보수적으로 잡으세요." />
                </Grid>
                <TextBlock Margin="4,14,4,0" TextWrapping="Wrap" Foreground="{StaticResource SubText}" FontSize="11"
                           Text="※ 청산 %는 매수 평균가 대비 가격 변동 기준입니다. 계좌 전체 한도(일 손실 한도, 동시 보유 수, 총 노출)는 [설정 → 리스크]에서 관리하며 봇 설정보다 우선합니다." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</dx:ThemedWindow>
