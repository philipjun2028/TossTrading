<Application x:Class="TossTrading.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TossTrading.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:SignBrushConverter x:Key="SignBrush" />
            <c:BoolToVisibilityConverter x:Key="BoolToVis" />
            <c:NullToVisibilityConverter x:Key="NullToVis" />
            <c:TimeOnlyConverter x:Key="TimeOnlyConv" />
            <c:ProgressConverter x:Key="Progress" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
