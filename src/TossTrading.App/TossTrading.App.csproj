<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- DevExpress 24.1 은 .NET 8 까지 지원: .NET 10 런타임에서는 PopupMenu 생성 시 NullReferenceException -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      DevExpress 24.1.7 (로컬 설치 패키지 소스 "DevExpress 24.1 Local" 사용).
      다른 버전으로 빌드하려면: dotnet build -p:DevExpressVersion=24.1.x
    -->
    <DevExpressVersion Condition="'$(DevExpressVersion)' == ''">24.1.7</DevExpressVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Wpf.Core" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Wpf.Grid" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Wpf.Charts" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Wpf.Themes.Win11Dark" Version="$(DevExpressVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- DevExpress 패키지가 WinForms 를 끌어와 Application/UserControl 이름이 겹치므로 WinForms 전역 using 제거 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TossTrading.Domain\TossTrading.Domain.csproj" />
    <ProjectReference Include="..\TossTrading.Engine\TossTrading.Engine.csproj" />
    <ProjectReference Include="..\TossTrading.Toss\TossTrading.Toss.csproj" />
  </ItemGroup>
</Project>
